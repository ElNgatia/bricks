# App Store publishing lanes. See PUBLISHING.md at the repo root for the runbook.
#
# One-time setup:
#   export APPLE_TEAM_ID=XXXXXXXXXX
#   export ASC_KEY_ID=XXXXXXXXXX
#   export ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#   export ASC_KEY_PATH=~/secrets/AuthKey_XXXXXXXXXX.p8

default_platform(:ios)

APP_ID = ENV["APP_IDENTIFIER"] || "{{org_name}}.{{project_name.camelCase()}}"
APP_NAME = ENV["APP_NAME"] || "{{project_name.titleCase()}}"

FLUTTER = ENV["FLUTTER_BIN"] ? File.expand_path(ENV["FLUTTER_BIN"]) : "flutter"

# deliver uploads whatever is in fastlane/metadata and fastlane/screenshots;
# until those exist, the lanes leave the current store listing alone.
SKIP_METADATA = !File.directory?(File.join(__dir__, "metadata"))
SKIP_SCREENSHOTS = !File.directory?(File.join(__dir__, "screenshots"))

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH")),
  )
end

# The CI upload step returns as soon as Apple accepts the ipa, but the build
# stays invisible to deliver until App Store Connect finishes processing it,
# and deliver fails with "Build number: N does not exist" in the meantime.
# Needs a Spaceship token, which asc_api_key sets. Returns the build.
def wait_for_processed_build(app_version, build_number, timeout: 45 * 60)
  app = Spaceship::ConnectAPI::App.find(APP_ID)
  deadline = Time.now + timeout
  loop do
    build = Spaceship::ConnectAPI::Build.all(
      app_id: app.id,
      version: app_version,
      build_number: build_number,
    ).first
    state = build&.processing_state
    return build if state == "VALID"
    UI.user_error!("Build #{build_number} failed processing: #{state}") if %w[FAILED INVALID].include?(state)
    UI.user_error!("Build #{build_number} still not processed after #{timeout / 60} minutes") if Time.now > deadline
    UI.message("Build #{build_number}: #{state || 'not visible yet'}, checking again in 30s")
    sleep(30)
  end
end

SUBMISSION_INFORMATION = {
  add_id_info_uses_idfa: false,
  export_compliance_uses_encryption: true,
  export_compliance_is_exempt: true,
}.freeze

platform :ios do
  desc "Register the bundle id and create the App Store Connect app record"
  lane :create_app do
    # produce has no api_key option - it reads the key from lane context,
    # which app_store_connect_api_key populates. Creating the App Store
    # Connect record itself still needs an Apple ID login, so in practice the
    # record is made once in the web UI. See PUBLISHING.md.
    asc_api_key
    produce(
      app_identifier: APP_ID,
      app_name: APP_NAME,
      app_version: "1.0.0",
      language: "en-US",
      sku: APP_ID,
    )
  end

  desc "Fetch or create the distribution certificate and App Store provisioning profile"
  lane :certs do
    api_key = asc_api_key
    # development: false yields an Apple Distribution certificate.
    get_certificates(api_key: api_key, development: false)
    get_provisioning_profile(api_key: api_key, app_identifier: APP_ID)
  end

  desc "Build a signed App Store ipa"
  lane :build do
    certs
    update_code_signing_settings(
      path: "Runner.xcodeproj",
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::SIGH_NAME],
      targets: ["Runner"],
    )
    Dir.chdir("../..") do
      sh("#{FLUTTER} build ios --release --no-codesign")
    end
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      output_directory: "../build/ios/ipa",
    )
  end

  desc "Upload metadata and screenshots only (no build)"
  lane :metadata do
    deliver(
      api_key: asc_api_key,
      skip_binary_upload: true,
      skip_metadata: SKIP_METADATA,
      skip_screenshots: SKIP_SCREENSHOTS,
      overwrite_screenshots: true,
      force: true,
      # precheck cannot inspect IAPs when authenticating with an API key.
      precheck_include_in_app_purchases: false,
    )
  end

  desc "Push a build to TestFlight"
  lane :beta do
    build
    upload_to_testflight(
      api_key: asc_api_key,
      ipa: lane_context[SharedValues::IPA_OUTPUT_PATH],
      skip_waiting_for_build_processing: true,
    )
  end

  desc "CI: upload metadata + screenshots and submit an already-uploaded build"
  lane :submit_review do |options|
    # Review contact details come from the environment so the demo password
    # never lands in the repo. Apple rejects the submission outright if the
    # contact phone or email is missing.
    review_info = {
      first_name: ENV.fetch("ASC_CONTACT_FIRST_NAME"),
      last_name: ENV.fetch("ASC_CONTACT_LAST_NAME"),
      email_address: ENV.fetch("ASC_CONTACT_EMAIL"),
      phone_number: ENV.fetch("ASC_CONTACT_PHONE"),
      demo_user: ENV["ASC_DEMO_USER"],
      demo_password: ENV["ASC_DEMO_PASSWORD"],
      notes: ENV["ASC_REVIEW_NOTES"] || "",
    }
    api_key = asc_api_key
    build = wait_for_processed_build(options.fetch(:app_version), options.fetch(:build_number).to_s)
    # Review submissions read export compliance from the build, not from
    # deliver's submission_information, and refuse a build that never
    # answered it. Builds carrying ITSAppUsesNonExemptEncryption in
    # Info.plist arrive answered; this covers any that don't.
    if build.uses_non_exempt_encryption.nil?
      UI.message("Build #{build.version}: setting export compliance (standard encryption only)")
      build.update(attributes: { uses_non_exempt_encryption: false })
    end
    deliver(
      api_key: api_key,
      app_version: options.fetch(:app_version),
      build_number: options.fetch(:build_number).to_s,
      skip_binary_upload: true,
      skip_metadata: SKIP_METADATA,
      skip_screenshots: SKIP_SCREENSHOTS,
      overwrite_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      force: true,
      precheck_include_in_app_purchases: false,
      app_review_information: review_info,
      submission_information: SUBMISSION_INFORMATION,
    )
  end

  desc "Full release: build, upload everything, submit for review"
  lane :release do
    build
    deliver(
      api_key: asc_api_key,
      ipa: lane_context[SharedValues::IPA_OUTPUT_PATH],
      skip_metadata: SKIP_METADATA,
      skip_screenshots: SKIP_SCREENSHOTS,
      overwrite_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      force: true,
      precheck_include_in_app_purchases: false,
      submission_information: SUBMISSION_INFORMATION,
    )
  end
end
