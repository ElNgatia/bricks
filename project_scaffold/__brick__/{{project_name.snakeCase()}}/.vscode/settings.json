{
  "dart.flutterSdkPath": ".fvm/flutter_sdk",
  "search.exclude": {
    "**/.fvm": true,
    "**/.dart_tool": true,
    "**/.git": true,
    "**/build": true
  },
  "files.watcherExclude": {
    "**/.fvm/**": true,
    "**/.dart_tool/**": true,
    "**/.git/**": true,
    "**/build/**": true
  },
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "Dart-Code.dart-code"
}

